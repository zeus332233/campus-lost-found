<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.ClaimMapper">
    <!-- 插入认领记录 -->
    <insert id="insert" parameterType="com.example.demo.model.Claim" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO claim (
        item_id,
        item_type,
        claimant_id,
        claim_description,
        status,
        approver_id,
        approval_time,
        create_time,
        update_time
    ) VALUES (
        #{itemId},
        #{itemType},
        #{claimantId},
        #{claimDescription},
        #{status},
        #{approverId},
        #{approvalTime},
        UNIX_TIMESTAMP()*1000,
        UNIX_TIMESTAMP()*1000
    )
</insert>

    <!-- 更新认领记录 -->
    <update id="updateById" parameterType="com.example.demo.model.Claim">
        UPDATE claim
        <set>
            <if test="itemId != null">item_id = #{itemId},</if>
            <if test="itemType != null">item_type = #{itemType},</if>
            <if test="claimantId != null">claimant_id = #{claimantId},</if>
            <if test="claimDescription != null">claim_description = #{claimDescription},</if>
            <if test="status != null">status = #{status},</if>
            <if test="approverId != null">approver_id = #{approverId},</if>
            <if test="approvalTime != null">approval_time = #{approvalTime},</if>
            update_time = UNIX_TIMESTAMP()*1000
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据ID查询认领记录 -->
    <select id="selectById" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT * FROM claim WHERE id = #{id}
    </select>

    <resultMap id="BaseResultMap" type="com.example.demo.model.Claim">
        <id column="id" property="id"/>
        <result column="item_id" property="itemId"/>
        <result column="item_type" property="itemType"/>
        <result column="claimant_id" property="claimantId"/>
        <result column="claim_description" property="claimDescription"/>
        <result column="status" property="status"/>
        <result column="approver_id" property="approverId"/>
        <result column="approval_time" property="approvalTime"/>
        <result column="reject_reason" property="rejectReason"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        select id, item_id, item_type, claimant_id, claim_description, status,
               approver_id, approval_time, reject_reason, create_time, update_time
        from claim
    </select>
</mapper>